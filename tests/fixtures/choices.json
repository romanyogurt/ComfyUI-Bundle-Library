{
 "about": "What a choice field carries, from its value, its source and what was read of the source's options (as GET /choices/{node}/{input} answers): resolve() in bundle_library/choices.py, resolveChoice() in web/choices.js.",
 "resolve": [
  {"case": "no source: typed freely, nothing to check",
   "value": "euler", "source": null, "lookup": null, "output": "euler", "state": "no_source"},
  {"case": "one of the options",
   "value": "euler", "source": true, "lookup": {"state": "read", "options": ["euler", "dpmpp_2m"], "paths": false},
   "output": "euler", "state": "ok"},
  {"case": "not one of the options",
   "value": "eular", "source": true, "lookup": {"state": "read", "options": ["euler", "dpmpp_2m"], "paths": false},
   "output": "eular", "state": "mismatch"},
  {"case": "an empty list was read: nothing is one of it",
   "value": "a.safetensors", "source": true, "lookup": {"state": "read", "options": [], "paths": false},
   "output": "a.safetensors", "state": "mismatch"},
  {"case": "an empty value is a value like any other",
   "value": "", "source": true, "lookup": {"state": "read", "options": ["", "x"], "paths": false},
   "output": "", "state": "ok"},
  {"case": "the same text, not the same letters in another case",
   "value": "Euler", "source": true, "lookup": {"state": "read", "options": ["euler"], "paths": false},
   "output": "Euler", "state": "mismatch"},
  {"case": "a model folder's file, written with the other slash: its spelling there",
   "value": "flux/detail.safetensors", "source": true,
   "lookup": {"state": "read", "options": ["base.safetensors", "flux\\detail.safetensors"], "paths": true},
   "output": "flux\\detail.safetensors", "state": "ok"},
  {"case": "and the other way",
   "value": "flux\\detail.safetensors", "source": true,
   "lookup": {"state": "read", "options": ["flux/detail.safetensors"], "paths": true},
   "output": "flux/detail.safetensors", "state": "ok"},
  {"case": "the same text comes first, even where another spelling would match too",
   "value": "a\\b.safetensors", "source": true,
   "lookup": {"state": "read", "options": ["a/b.safetensors", "a\\b.safetensors"], "paths": true},
   "output": "a\\b.safetensors", "state": "ok"},
  {"case": "two files match with the slashes taken alike: neither is chosen",
   "value": "a/b/c.safetensors", "source": true,
   "lookup": {"state": "read", "options": ["a/b\\c.safetensors", "a\\b/c.safetensors"], "paths": true},
   "output": "a/b/c.safetensors", "state": "mismatch"},
  {"case": "not a model folder's list: a backslash is a letter of its own",
   "value": "style/warm", "source": true, "lookup": {"state": "read", "options": ["style\\warm"], "paths": false},
   "output": "style/warm", "state": "mismatch"},
  {"case": "the source is not here: passes, unchecked",
   "value": "x.safetensors", "source": true, "lookup": {"state": "not_found", "reason": "no_node"},
   "output": "x.safetensors", "state": "not_found"},
  {"case": "the source is not one choice among text options: passes, unchecked",
   "value": "4", "source": true, "lookup": {"state": "unsupported", "reason": "not_text"},
   "output": "4", "state": "unsupported"},
  {"case": "reading the source failed: passes, unchecked",
   "value": "x", "source": true, "lookup": {"state": "error", "reason": "failed"},
   "output": "x", "state": "error"}
 ]
}
